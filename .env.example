# 1Panel 环境变量示例
# 容器编排里直接用 docker-compose.yml 的 environment 字段即可；
# 若使用「网站 → Node 项目」运行，可复制本文件为 .env 后用启动脚本加载。

# ---- 可选功能开关（默认都是 false：开箱即用，直接上传/下载）----
# 是否需要登录后才能上传/删除
REQUIRE_LOGIN=false
# 是否需要 6 位数字提取码才能下载
REQUIRE_CODE=false

# ---- 账号（仅当 REQUIRE_LOGIN=true 时生效，务必修改）----
ADMIN_USER=admin
ADMIN_PASSWORD=请改成强密码
# 额外账号，逗号分隔
# USERS=zhang:123456,li:abcdef

# ---- 服务 ----
PORT=3000
HOST=0.0.0.0
# 数据目录（上传文件 + files.json）
DATA_DIR=/opt/ie-webdisk/data

# ---- 业务 ----
# 单文件上限（字节），默认 500MB
MAX_FILE_SIZE=524288000
# 提取码有效期可选值（天）
EXPIRE_DAYS=1,3,7,30
DEFAULT_EXPIRE_DAYS=7
# 下载限流
RATE_WINDOW_MS=60000
RATE_MAX=30